 ],
 "lines": [
  {
   "spk": "CIRAK",
   "text": "Üç haftadır aynı mesajı yazıp siliyorum.",
   "start": 0.0,
   "end": 3.24
  },
  {
   "spk": "HOCA",
   "text": "Kime?",
   "start": 4.02,
   "end": 4.46
  },
  {
   "spk": "CIRAK",
   "text": "Eski bir arkadaşıma. Küstük, sonra hiç konuşmadık.",
   "start": 5.32,
   "end": 10.08
  },
  {
   "spk": "HOCA",
   "text": "Peki ne yazıyorsun?",
   "start": 10.84,
   "end": 11.84
  },
  {
   "spk": "CIRAK",
   "text": "Seni özledim. Sadece bu kadar.",
   "start": 13.06,
   "end": 16.12
  },
  {
   "spk": "HOCA",
   "text": "Neden göndermiyorsun?",
   "start": 16.88,
   "end": 18.34
  },
  {
   "spk": "CIRAK",
   "text": "Doğru zamanı bekliyorum. Belki yarın daha iyi olur.",
   "start": 19.4,
   "end": 23.34
  },
  {
   "spk": "HOCA",
   "text": "Dün de aynı şeyi söylemiştin.",
   "start": 24.3,
   "end": 26.6
  },
  {
   "spk": "CIRAK",
   "text": "Dün de yarının daha iyi olacağını sanıyordum.",
   "start": 27.24,
   "end": 30.66
  },
  {
   "spk": "HOCA",
   "text": "Çayın ne zamandır önünde?",
   "start": 31.32,
   "end": 33.04
  },
  {
   "spk": "CIRAK",
   "text": "Biraz soğusun diye bekledim.",
   "start": 33.84,
   "end": 35.82
  },
  {
   "spk": "HOCA",
   "text": "Bak, soğudu. Hâlâ içmiyorsun.",
   "start": 36.62,
   "end": 39.36
  },
  {
   "spk": "CIRAK",
   "text": "Yani ben hep mi bekliyorum?",
   "start": 40.28,
   "end": 42.16
  },
  {
   "spk": "HOCA",
   "text": "Bekliyorsun çocuğum. Ama bazı şeyler beklerken soğur.",
   "start": 42.96,
   "end": 47.52
  },
  {
   "spk": "HOCA",
   "text": "Doğru zaman, korkunun geçtiği gün değildir.",
   "start": 48.22,
   "end": 51.24
  },
  {
   "spk": "HOCA",
   "text": "Elin titrerken gönder dediğin gündür.",
   "start": 51.84,
   "end": 54.64
  },
  {
   "spk": "HOCA",
   "text": "Gönderilmemiş bir mesaj, bir ömür taslak kalır.",
   "start": 54.64,
   "end": 59.04
  },
  {
   "spk": "CIRAK",
   "text": "Ya cevap vermezse?",
   "start": 59.68,
   "end": 61.06
  },
  {
   "spk": "HOCA",
   "text": "O zaman bir cevabın olur. Göndermezsen, elinde sadece bir soru kalır.",
   "start": 61.96,
   "end": 68.2
  },
  {
   "spk": "HOCA",
   "text": "Unutma, çay yeniden ısıtılır. Ama bazı sessizlikler bir daha ısınmaz.",
   "start": 68.7,
   "end": 74.3
  },
  {
   "spk": "HOCA",
   "text": "Dinle, düşün ve kendine bir çay daha koy.",
