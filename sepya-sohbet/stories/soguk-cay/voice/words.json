 ],
 "lines": [
  {
   "spk": "CIRAK",
   "text": "Üç haftadır aynı mesajı yazıp siliyorum.",
   "start": 0.0,
   "end": 3.26
  },
  {
   "spk": "HOCA",
   "text": "Kime?",
   "start": 3.82,
   "end": 4.5
  },
  {
   "spk": "CIRAK",
   "text": "Eski bir arkadaşıma. Küstük, sonra hiç konuşmadık.",
   "start": 5.4,
   "end": 10.04
  },
  {
   "spk": "HOCA",
   "text": "Peki ne yazıyorsun?",
   "start": 10.8,
   "end": 11.88
  },
  {
   "spk": "CIRAK",
   "text": "Seni özledim. Sadece bu kadar.",
   "start": 13.04,
   "end": 16.04
  },
  {
   "spk": "HOCA",
   "text": "Neden göndermiyorsun?",
   "start": 16.88,
   "end": 18.28
  },
  {
   "spk": "CIRAK",
   "text": "Doğru zamanı bekliyorum. Belki yarın daha iyi olur.",
   "start": 19.38,
   "end": 23.46
  },
  {
   "spk": "HOCA",
   "text": "Çayın ne zamandır önünde?",
   "start": 24.46,
   "end": 26.38
  },
  {
   "spk": "CIRAK",
   "text": "Biraz soğusun diye bekledim.",
   "start": 27.14,
   "end": 29.14
  },
  {
   "spk": "HOCA",
   "text": "Bak, soğudu. Hâlâ içmiyorsun.",
   "start": 29.14,
   "end": 32.58
  },
  {
   "spk": "CIRAK",
   "text": "Yani ben hep mi bekliyorum?",
   "start": 33.48,
   "end": 35.38
  },
  {
   "spk": "HOCA",
   "text": "Bekliyorsun çocuğum. Ama bazı şeyler beklerken soğur.",
   "start": 36.28,
   "end": 40.86
  },
  {
   "spk": "HOCA",
   "text": "Doğru zaman, korkunun geçtiği gün değildir.",
   "start": 41.54,
   "end": 44.62
  },
  {
   "spk": "HOCA",
   "text": "Elin titrerken gönder dediğin gündür.",
   "start": 45.18,
   "end": 47.94
  },
  {
   "spk": "HOCA",
   "text": "Gönderilmemiş bir mesaj, bir ömür taslak kalır.",
   "start": 48.58,
   "end": 52.26
  },
  {
   "spk": "HOCA",
   "text": "Unutma, çay yeniden ısıtılır. Ama bazı sessizlikler bir daha ısınmaz.",
   "start": 52.78,
   "end": 58.48
  },
  {
   "spk": "HOCA",
   "text": "Dinle, düşün ve kendine bir çay daha koy.",
   "start": 59.14,
   "end": 61.96
  }
 ],
 "duration": 62.575
}