   "spk": "CIRAK",
   "text": "Ekip arkadaşım müdüre benim hakkımda yalan söylemiş.",
   "start": 0.0,
   "end": 3.72
  },
  {
   "spk": "HOCA",
   "text": "Nereden duydun?",
   "start": 4.24,
   "end": 5.64
  },
  {
   "spk": "CIRAK",
   "text": "Başka bir arkadaş anlattı. Toplantıda beni suçlamış.",
   "start": 6.64,
   "end": 10.32
  },
  {
   "spk": "HOCA",
   "text": "Peki sen ne yapacaksın?",
   "start": 10.64,
   "end": 13.1
  },
  {
   "spk": "CIRAK",
   "text": "Ben de onun hatalarını tek tek anlatacağım. Bakalım kim kazanacak.",
   "start": 13.92,
   "end": 17.9
  },
  {
   "spk": "HOCA",
   "text": "Bunu sana anlatan arkadaş, ona da senin hakkında bir şey anlatmış mıdır?",
   "start": 18.7,
   "end": 23.8
  },
  {
   "spk": "CIRAK",
   "text": "Şey... Bunu hiç düşünmedim.",
   "start": 24.92,
   "end": 26.9
  },
  {
   "spk": "HOCA",
   "text": "Şu tahtaya bak. At neden bu kadar tehlikelidir, bilir misin?",
   "start": 27.7,
   "end": 32.84
  },
  {
   "spk": "CIRAK",
   "text": "Taşların üstünden atlayabildiği için mi?",
   "start": 33.24,
   "end": 35.32
  },
  {
   "spk": "HOCA",
   "text": "Evet. Kimse nereden geleceğini bilmez. Ama atın da onu oynatan bir eli vardır.",
   "start": 35.98,
   "end": 42.42
  },
  {
   "spk": "CIRAK",
   "text": "Ama o başlattı. Yani susup yutayım mı?",
   "start": 43.26,
   "end": 46.32
  },
  {
   "spk": "HOCA",
   "text": "Susma çocuğum. Ama arkasından değil, yüzüne konuş.",
   "start": 47.12,
   "end": 51.44
  },
  {
   "spk": "HOCA",
   "text": "Birbirinizin arkasından at oynattıkça, ikiniz de başkasının oyununda taş olursunuz.",
   "start": 52.16,
   "end": 58.36
  },
  {
   "spk": "HOCA",
   "text": "Ve o oyunu, sizi birbirinize düşüren el kazanır.",
   "start": 58.36,
   "end": 63.44
  },
  {
   "spk": "HOCA",
   "text": "Arkadan söylenen söz yolda büyür. Yüze söylenen söz yerinde kalır.",
   "start": 63.7,
   "end": 69.78
  },
  {
   "spk": "HOCA",
   "text": "Başlatan her zaman biridir. Bitirmek ise cesaret ister.",
   "start": 70.02,
   "end": 75.28
  },
  {
   "spk": "HOCA",
   "text": "Unutma, herkesin birbirine kuyu kazdığı yerde kimse rahat yürüyemez.",
   "start": 75.9,
   "end": 81.64
  },
  {
   "spk": "HOCA",
   "text": "Dinle, düşün ve kendine bir çay daha koy.",
   "start": 81.96,
   "end": 86.08
  }
 ],
 "duration": 86.345
}